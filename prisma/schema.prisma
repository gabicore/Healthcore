generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StudioPlanTier {
  Essencial
  Profissional
  Studio
}

enum Sex {
  Feminino
  Masculino
  Outro
}

enum Weekday {
  Segunda
  Terca
  Quarta
  Quinta
  Sexta
  Sabado
}

enum PlanPeriod {
  mensal
  trimestral
  semestral
}

enum PaymentStatus {
  pago
  pendente
  atrasado
}

enum PaymentMethod {
  PIX
  CartaoCredito
  Boleto
  Dinheiro
}

enum AttendanceStatus {
  agendada
  presente
  falta
  reposicao
  cancelada
}

enum ClassSessionType {
  fixa
  avulsa
  reposicao
  experimental
}

enum ContractStatus {
  rascunho
  pendente_assinatura
  ativo
  encerrado
  cancelado
}

enum ExpenseCategory {
  aluguel
  contas
  pessoal
  material
  software
  outros
}

enum ExpenseStatus {
  pago
  pendente
}

enum TimePeriod {
  manha
  tarde
}

enum CampaignType {
  aniversarios
  eventos
  promocoes
  marketing
  whatsapp
  email
  fidelizacao
  reativacao
}

enum CampaignChannel {
  whatsapp
  email
  sms
  interno
}

enum CampaignStatus {
  rascunho
  agendada
  em_andamento
  pausada
  finalizada
}

enum PlanKind {
  mensalidade
  pacote
  avulso
}

enum ServiceCategory {
  pilates
  fisioterapia
  massoterapia
  auriculoterapia
  avaliacao
  experimental
  outro
}

enum ClinicalAttendanceStatus {
  agendada
  realizada
  falta
  cancelada
}

enum CampaignAudience {
  todos
  ativos
  inativos
  aniversariantes
  inadimplentes
  responsaveis
}

enum CampaignAutomation {
  aniversario
  lembrete
  pos_venda
  reativacao
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
  FINANCIAL
  STUDENT
  RESPONSIBLE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum AuthAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REGISTER
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  EMAIL_VERIFY
  SESSION_REVOKE
  ACCOUNT_LOCK
  ACCOUNT_UNLOCK
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  emailVerified  Boolean    @default(false)
  image          String?
  role           UserRole   @default(RECEPTIONIST)
  status         UserStatus @default(ACTIVE)
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  professionalId String?    @unique
  studentId      String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  sessions     Session[]
  accounts     Account[]
  auditLogs    AuthAuditLog[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AuthAuditLog {
  id        String          @id @default(cuid())
  userId    String?
  email     String?
  action    AuthAuditAction
  ip        String?
  userAgent String?         @db.Text
  metadata  Json?
  createdAt DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
  @@map("auth_audit_log")
}

model Studio {
  id        String         @id @default(cuid())
  name      String
  owner     String
  email     String
  phone     String
  cnpj      String         @default("")
  address   String         @default("") @db.Text
  plan      StudioPlanTier @default(Profissional)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  plans                Plan[]
  professionals        Professional[]
  studioHours          StudioHour[]
  timeSlots            TimeSlot[]
  students             Student[]
  services             Service[]
  clinicalAttendances  ClinicalAttendance[]
  inventoryProducts    InventoryProduct[]
  expenses             Expense[]
  campaigns            Campaign[]
  contracts            Contract[]
  classSessions        ClassSession[]
}

model Plan {
  id             String      @id // keep stable ids from seed (sem-2x, etc.)
  studioId       String
  name           String
  kind           PlanKind    @default(mensalidade)
  period         PlanPeriod
  frequency      Int
  frequencyLabel String
  price          Decimal     @db.Decimal(10, 2)
  /** Crédito de sessões para pacote/avulso. Null em mensalidade. */
  sessionsTotal  Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  studio    Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  students  Student[]
  contracts Contract[]

  @@index([studioId])
}

model Professional {
  id           String   @id @default(cuid())
  studioId     String
  name         String
  role         String
  registration String
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studio              Studio               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user                User?
  services            Service[]
  clinicalAttendances ClinicalAttendance[]

  @@index([studioId])
}

model StudioHour {
  id       String  @id @default(cuid())
  studioId String
  weekday  Weekday
  open     String  @db.VarChar(5)
  close    String  @db.VarChar(5)
  closed   Boolean @default(false)

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, weekday])
  @@index([studioId])
}

model TimeSlot {
  id       String     @id @default(cuid())
  studioId String
  period   TimePeriod
  time     String     @db.VarChar(5)
  capacity Int        @default(4)

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, time])
  @@index([studioId])
}

model Student {
  id               String        @id @default(cuid())
  studioId         String
  name             String
  birthDate        DateTime      @db.Date
  sex              Sex
  cpf              String        @default("")
  phone            String        @default("")
  email            String        @default("")
  cep              String        @default("")
  street           String        @default("")
  addressNumber    String        @default("")
  neighborhood     String        @default("")
  city             String        @default("")
  state            String        @default("")
  address          String        @db.Text
  emergencyName     String        @default("")
  emergencyRelation String        @default("")
  emergencyPhone    String        @default("")
  /** Texto composto (nome + parentesco + telefone) para contratos/impressão. */
  emergencyContact  String        @db.Text
  active           Boolean       @default(true)
  since            DateTime      @db.Date
  objective        String        @db.Text
  pathologies      String        @db.Text
  injuries         String        @db.Text
  surgeries        String        @db.Text
  restrictions     String        @db.Text
  medications      String        @db.Text
  notes            String        @db.Text
  usesPilates      Boolean       @default(true)
  usesClinic       Boolean       @default(false)
  planId           String?
  monthlyValue     Decimal?      @db.Decimal(10, 2)
  discountPercent  Int           @default(0)
  dueDay           Int           @default(10)
  paymentMethod    PaymentMethod @default(PIX)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  studio               Studio               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  plan                 Plan?                @relation(fields: [planId], references: [id])
  schedule             ScheduleSlot[]
  payments             Payment[]
  assessments          PhysicalAssessment[]
  evolutions           Evolution[]
  photos               EvolutionPhoto[]
  contracts            Contract[]
  sessions             ClassSession[]
  clinicalAttendances  ClinicalAttendance[]
  user                 User?

  @@index([studioId])
  @@index([planId])
  @@index([active])
  @@index([name])
}

model ScheduleSlot {
  id            String    @id @default(cuid())
  studentId     String
  weekday       Weekday
  time          String    @db.VarChar(5)
  /** Início da vigência deste horário na grade do aluno. */
  effectiveFrom DateTime  @db.Date
  /** Fim da vigência (inclusive). Null = grade atual. */
  effectiveTo   DateTime? @db.Date

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, weekday, time, effectiveFrom])
  @@index([studentId])
}

model Payment {
  id        String         @id @default(cuid())
  studentId String
  reference String
  dueDate   DateTime       @db.Date
  amount    Decimal        @db.Decimal(10, 2)
  status    PaymentStatus  @default(pendente)
  method    PaymentMethod?
  paidAt    DateTime?      @db.Date
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model PhysicalAssessment {
  id          String   @id @default(cuid())
  studentId   String
  date        DateTime @db.Date
  weight      Float
  height      Float
  bodyFat     Float?
  muscleMass  Float?
  armRight    Float
  armLeft     Float
  chest       Float
  waist       Float
  abdomen     Float
  hip         Float
  thighRight  Float
  thighLeft   Float
  calfRight   Float
  calfLeft    Float
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Evolution {
  id           String   @id @default(cuid())
  studentId    String
  date         DateTime @db.Date
  professional String
  clinical     String   @db.Text
  complaints   String   @db.Text
  improvements String   @db.Text
  exercises    String   @db.Text
  conduct      String   @db.Text
  createdAt    DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model EvolutionPhoto {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime @db.Date
  label     String
  url       String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Contract {
  id                    String         @id @default(cuid())
  studioId              String
  studentId             String
  number                String
  planId                String
  planLabel             String
  startDate             DateTime       @db.Date
  endDate               DateTime       @db.Date
  status                ContractStatus @default(rascunho)
  monthlyValue          Decimal        @db.Decimal(10, 2)
  discountPercent       Int            @default(0)
  discountNote          String?
  dueDay                Int
  paymentMethod         PaymentMethod
  financialResponsible  String
  lateFeePercent        Float          @default(2)
  interestPercent       Float          @default(1)
  clauses               Json
  signedAt              DateTime?      @db.Date
  signatureName         String?
  signingToken          String?        @unique
  validationCode        String?        @unique
  version               Int            @default(1)
  previousVersions      Json
  history               Json
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  studio    Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  student   Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  signature ContractSignature?

  @@unique([studioId, number])
  @@index([studentId])
  @@index([studioId])
}

model ContractSignature {
  id                String   @id @default(cuid())
  contractId        String   @unique
  signerName        String
  signatureImage    String   @db.LongText
  signedAt          DateTime
  ipAddress         String   @default("")
  userAgent         String   @default("") @db.Text
  tokenUsed         String
  contractVersion   Int
  documentHash      String
  documentSnapshot  Json
  validationCode    String   @unique
  createdAt         DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([validationCode])
}

model Expense {
  id        String          @id @default(cuid())
  studioId  String
  name      String
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(10, 2)
  dueDay    Int
  status    ExpenseStatus   @default(pendente)
  paidAt    DateTime?       @db.Date
  recurring Boolean         @default(true)
  notes     String?         @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
}

model Campaign {
  id              String              @id @default(cuid())
  studioId        String
  name            String
  type            CampaignType
  channel         CampaignChannel
  audience        CampaignAudience
  audienceLabel   String
  startDate       DateTime            @db.Date
  endDate         DateTime?           @db.Date
  scheduledAt     DateTime?
  status          CampaignStatus      @default(rascunho)
  messageTemplate String              @db.Text
  variables       Json
  attachments     Json
  automation      CampaignAutomation?
  statsSent       Int                 @default(0)
  statsOpened     Int                 @default(0)
  statsClicked    Int                 @default(0)
  statsConverted  Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([status])
}

model ClassSession {
  id             String           @id @default(cuid())
  studioId       String
  studentId      String?
  guestName      String?
  date           DateTime         @db.Date
  weekday        Weekday
  time           String           @db.VarChar(5)
  status         AttendanceStatus @default(agendada)
  type           ClassSessionType @default(fixa)
  professionalId String?
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  studio  Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([studioId, date])
  @@index([studentId])
}

model Service {
  id                        String          @id @default(cuid())
  studioId                  String
  name                      String
  category                  ServiceCategory
  durationMinutes           Int             @default(60)
  price                     Decimal         @db.Decimal(10, 2) @default(0)
  professionalId            String?
  requiresInitialAssessment Boolean         @default(false)
  requiresEvolution         Boolean         @default(false)
  active                    Boolean         @default(true)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  studio              Studio               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  professional        Professional?        @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  clinicalAttendances ClinicalAttendance[]

  @@index([studioId])
  @@index([studioId, active])
  @@index([category])
}

model ClinicalAttendance {
  id               String                    @id @default(cuid())
  studioId         String
  studentId        String
  serviceId        String
  professionalId   String
  date             DateTime                  @db.Date
  weekday          Weekday
  time             String                    @db.VarChar(5)
  durationMinutes  Int                       @default(60)
  status           ClinicalAttendanceStatus  @default(agendada)
  notes            String?                   @db.Text
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  studio       Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  @@index([studioId, date])
  @@index([studentId])
  @@index([serviceId])
  @@index([professionalId, date, time])
}

model InventoryProduct {
  id          String    @id @default(cuid())
  studioId    String
  name        String
  category    String    @default("")
  lot         String    @default("")
  expiresAt   DateTime? @db.Date
  quantity    Int       @default(0)
  minQuantity Int       @default(0)
  supplier    String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([studioId, name])
}
